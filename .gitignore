# ---- Editors / OS noise ----
.DS_Store
.AppleDouble
.LSOverride
.idea/
.vscode/
*.swp
*.swo
*.swn
*.iml
*~

# ---- Secrets / local-only config ----
*.jks
*.keystore
*.p12
*.p8
.env
.env.*
# Generated SOPS outputs (decrypted bundle + env export + key fingerprint)
.mise/secrets.env
.mise/secrets.json
.mise/.sops-age-key-fingerprint
age.key
local.properties

# direnv: the local file is per-developer; the template is committed
!.envrc.example

# Cargo cross-compile output lives inside the core/ submodule workspace.
# We build from there (`cd core && cargo build ...`); the resulting target/
# tree is repo-specific and not versionable.
core/target/

# Cross-compile config written by android-dev-init / ios-dev-init via
# _cargo_marker.py. Contains machine-specific NDK/SDK paths and rustflags;
# generated locally and regenerated on each dev-init run.
.cargo/

# Generated iOS BuildConfig (regenerated by mise run secrets-ios-buildconfig)
ios/Livtet/Resources/BuildConfig.generated.swift

# direnv local state
.direnv/

# ---- Gradle / Kotlin daemon (Android) ----
.gradle/
.kotlin/
**/build/
**/.gradle/
**/.kotlin/
**/.cxx/
.cxx/
captures/

# ---- Android build outputs ----
*.apk
*.aab
*.ap_
*.aar
*.dex
*.class
*.log

# UniFFI-generated Kotlin bindings (mobile/android/AGENTS.md)
**/build/generated/

# Prebuilt Rust .so cache for the FFI bridge (mobile/android/AGENTS.md)
android/app/src/main/jniLibs/

# playstore-only baseline profile, regenerated per build
android/app/src/main/baseline-prof.txt

# ---- IDE / Xcode / iOS ----
# Note: ios/Podfile.lock is intentionally committed when present.
ios/Pods/
ios/.derivedData/
ios/.build/
ios/.swiftpm/
ios/**/Package.resolved

# xcframework: produced by `mise run ios-build` (mobile/ios/AGENTS.md)
ios/LivtetKit.xcframework/

# ---- UniFFI-generated Swift / C bindings (mobile/ios/AGENTS.md) ----
# GENERATED — do not commit; `mise run ios-build` (uniffi-bindgen) rewrites these:
#   - Swift bindings: Sources/LivtetKit/{livtet_ffi,LivtetTypes,LivtetSearch}.swift
#   - C bridge headers: Sources/*FFI/*.h and Sources/*FFI/*.modulemap
# TRACKED — Sources/*FFI/placeholder.c is hand-written, not generated. The C
# bridge targets are header-only, so SwiftPM would emit no object file and
# Xcode's required-input list would fail on clean builds; the empty
# translation unit fixes that. It must therefore stay committable, which is
# why the FFI dirs are matched by file pattern rather than ignored wholesale.
ios/LivtetKit/Sources/LivtetKit/livtet_ffi.swift
ios/LivtetKit/Sources/LivtetKit/LivtetTypes.swift
ios/LivtetKit/Sources/LivtetKit/LivtetSearch.swift
ios/LivtetKit/Sources/*FFI/*.h
ios/LivtetKit/Sources/*FFI/*.modulemap

# Legacy UniFFI output dirs, superseded by the flat Sources/*FFI/ layout.
# Whole-dir ignores so stale local copies never resurface in the index.
ios/LivtetKit/Sources/LivtetKitFFI/
ios/LivtetKit/Sources/LivtetKitFFI_types/
ios/LivtetKit/Sources/livtet_ffi_typesFFI/

xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
DerivedData/
*.xcarchive
*.dSYM/
*.dSYM.zip
*.ipa

# ---- SnapshotTesting generated artifacts ----
# Checked-in reference sources live in ios/LivtetUnitTests/Snapshots/*.swift;
# SnapshotTesting renders reference PNGs into a generated __Snapshots__/<TestClass>/
# tree beneath them, which is machine-specific output and should not be tracked.
**/__Snapshots__/

# ---- Fastlane transient output ----
fastlane/report.xml
fastlane/Preview.html
fastlane/test_output
fastlane/screenshots
fastlane/.build-counter

# ---- Emulator / simulator state files (per-device serials/UDIDs) ----
.livtet-emulator-*.serial
.Livtet*.udid

# Superpowers worktrees
.worktrees/android/docs
android/docs/
android/kls_database.db
.cortexkit/
