#!/usr/bin/env bash
#MISE description="Generate age key pair, bootstrap .sops.yaml, and create the initial encrypted secrets file"
set -euo pipefail

KEY_FILE="age.key"
SOPS_CONFIG=".sops.yaml"

if [ -f "$KEY_FILE" ]; then
	echo "Error: $KEY_FILE already exists. Remove it first if you want to rotate the key." >&2
	exit 1
fi

echo "Generating age key pair..."
mise exec aqua:age -- age-keygen -o "$KEY_FILE"

# Extract the public key (the comment line in the generated key file, e.g. "# public key: age1...")
PUBLIC_KEY="$(grep -oE 'age1[a-z0-9]+' "$KEY_FILE" | head -n1)"
PRIVATE_KEY="$(grep -oE 'AGE-SECRET-KEY-[A-Z0-9]+' "$KEY_FILE" | head -n1)"

if [ -z "$PUBLIC_KEY" ] || [ -z "$PRIVATE_KEY" ]; then
	echo "Error: failed to parse generated key file" >&2
	exit 1
fi

cat <<EOF

Generated age key pair. The private key file '$KEY_FILE' is gitignored — do NOT commit it.

────────────────────────────── NEXT STEPS ──────────────────────────────

1. Update $SOPS_CONFIG with the public key (replace the placeholder):
   Replace the line:        age: "AGE1_PUBLIC_KEY_PLACEHOLDER"
   With:                    age: "$PUBLIC_KEY"

2. Set the SOPS_AGE_KEY env var in your shell environment
   (~/.zshrc, ~/.bashrc, password manager, or .envrc):
       export SOPS_AGE_KEY="$PRIVATE_KEY"

3. Re-run this task to create the initial encrypted secrets file:
       mise run secrets-init

────────────────────────────────────────────────────────────────────────
EOF