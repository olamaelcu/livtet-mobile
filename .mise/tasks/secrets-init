#!/usr/bin/env bash
#MISE description="Generate age key pair, bootstrap .sops.yaml, and create the initial encrypted secrets file"
set -euo pipefail

KEY_FILE="age.key"
SOPS_CONFIG=".sops.yaml"
ENCRYPTED_FILE=".mise/secrets.json.sops"

# Portable in-place replacement of the age: "age1..." line in .sops.yaml.
# Uses awk (not sed -i) so this works on both GNU and BSD systems.
update_sops_yaml() {
	local public_key="$1"
	local tmp
	tmp=$(mktemp)
	awk -v k="$public_key" '
		/age: "age1[a-z0-9]+"/ { sub(/age: "age1[a-z0-9]+"/, "age: \"" k "\"") }
		{ print }
	' "$SOPS_CONFIG" >"$tmp"
	if ! grep -qE "age: \"$public_key\"" "$tmp"; then
		echo "Error: failed to update $SOPS_CONFIG with the new public key." >&2
		echo "Expected an existing age: \"age1...\" line to replace; got:" >&2
		cat "$SOPS_CONFIG" >&2
		rm -f "$tmp"
		exit 1
	fi
	mv "$tmp" "$SOPS_CONFIG"
}

# --- First-time bootstrap: no key yet ---
if [ ! -f "$KEY_FILE" ]; then
	echo "Generating age key pair..."
	mise exec aqua:age -- age-keygen -o "$KEY_FILE"

	PUBLIC_KEY="$(grep -oE 'age1[a-z0-9]+' "$KEY_FILE" | head -n1)"
	PRIVATE_KEY="$(grep -oE 'AGE-SECRET-KEY-[A-Z0-9]+' "$KEY_FILE" | head -n1)"

	if [ -z "$PUBLIC_KEY" ] || [ -z "$PRIVATE_KEY" ]; then
		echo "Error: failed to parse generated key file" >&2
		exit 1
	fi

	update_sops_yaml "$PUBLIC_KEY"

	cat <<EOF

Generated age key pair. The private key file '$KEY_FILE' is gitignored — do NOT commit it.

────────────────────────────── NEXT STEPS ──────────────────────────────

1. Set the SOPS_AGE_KEY env var in your shell environment
   (~/.zshrc, ~/.bashrc, password manager, or .envrc):
       export SOPS_AGE_KEY="$PRIVATE_KEY"

2. Re-run this task to create the initial encrypted secrets file:
       mise run secrets-init

3. Add real secrets to the bundle:
       mise run secrets-edit

───────────────────────────────────────────────────────────────────────
EOF
	exit 0
fi

# --- Re-run path: key exists ---

# Refuse to silently wrap an existing SOPS envelope. Re-encrypting a file
# that's already a SOPS envelope with `sops --encrypt --in-place` adds
# another encryption layer, producing nested ciphertext that no one can
# decrypt. To modify an existing bundle, use `secrets-edit`.
if [ -f "$ENCRYPTED_FILE" ]; then
	if grep -q '"sops"' "$ENCRYPTED_FILE"; then
		echo "$ENCRYPTED_FILE already exists and is a SOPS envelope." >&2
		echo "Refusing to re-encrypt, which would wrap the existing ciphertext" >&2
		echo "in another layer." >&2
		echo "" >&2
		echo "To modify it:        mise run secrets-edit" >&2
		echo "To rotate keys:      rm $ENCRYPTED_FILE && mise run secrets-init" >&2
		exit 1
	fi
	# Plaintext file — fine to encrypt.
	if [ -z "${SOPS_AGE_KEY:-}" ]; then
		echo "Error: SOPS_AGE_KEY is not set." >&2
		echo "Export it (or load via direnv) and re-run." >&2
		exit 1
	fi
	mise exec aqua:getsops/sops -- sops --encrypt --in-place "$ENCRYPTED_FILE"
	echo "Encrypted $ENCRYPTED_FILE"
	exit 0
fi

# No encrypted bundle yet — create one seeded with {}.
if [ -z "${SOPS_AGE_KEY:-}" ]; then
	echo "Error: SOPS_AGE_KEY is not set." >&2
	echo "Export it (or load via direnv) and re-run." >&2
	exit 1
fi
mkdir -p "$(dirname "$ENCRYPTED_FILE")"
echo '{}' >"$ENCRYPTED_FILE"
mise exec aqua:getsops/sops -- sops --encrypt --in-place "$ENCRYPTED_FILE"
echo "Wrote $ENCRYPTED_FILE — add real secrets with 'mise run secrets-edit'"
