#!/usr/bin/env bash
#MISE description="Build native libs (core/livtet-ffi), generate bindings, and assemble Android APK"
#MISE env={_.file=".mise/secrets.env"}
#MISE depends=["secrets-export-env"]
#MISE sources=["core/livtet-ffi/**/*.rs", "core/livtet-core/**/*.rs", "core/livtet-plugin/**/*.rs", "android/**/*.kt", "android/**/*.kts", "android/app/src/main/res/**", "android/app/src/**/AndroidManifest.xml"]
#USAGE flag "--flavor <flavor>" help="Android product flavor" default="generic" {
#USAGE   choices "generic" "playstore" "fdroid"
#USAGE }
#USAGE flag "--profile <profile>" help="Build profile" default="debug" {
#USAGE   choices "debug" "release"
#USAGE }
#USAGE flag "--target <target>" help="Architecture targets (emulator = x86_64 only, matches AVD system image; device = arm64; all = arm64+x86)" default="emulator" {
#USAGE   choices "all" "device" "emulator" "arm64" "x86_64" "x86"
#USAGE }
#USAGE flag "--clean" help="Clean build artifacts before building" default="false"

set -e
# shellcheck disable=SC1091
source "$(dirname "${BASH_SOURCE[0]}")/_os-check" && require_os linux

# Stale NDK_HOME/ANDROID_HOME from the user's shell can point at deleted NDK
# installs and confuse cc-rs NDK detection. The correct values come from
# .cargo/config.toml [env] (generated by android-dev-init).
unset NDK_HOME ANDROID_HOME

# shellcheck source=/dev/null
source "$(dirname "${BASH_SOURCE[0]}")/_build_profile.sh"

FLAVOR="${usage_flavor:-generic}"
FLAVOR_CAP="${FLAVOR^}"
PROFILE_CAP="${PROFILE^}"

# Cargo workspace lives in core/ (git submodule). All cargo + uniffi-bindgen
# commands run from there; the resulting target/ tree sits at core/target/.
CARGO_WS="core"
JNI_LIBS_DIR="android/app/src/main/jniLibs"

case "${usage_target:-emulator}" in
all)
	TARGETS=(aarch64-linux-android i686-linux-android x86_64-linux-android)
	ABIS=(arm64-v8a x86 x86_64)
	;;
device)
	TARGETS=(aarch64-linux-android)
	ABIS=(arm64-v8a)
	;;
emulator)
	TARGETS=(x86_64-linux-android)
	ABIS=(x86_64)
	;;
arm64)
	TARGETS=(aarch64-linux-android)
	ABIS=(arm64-v8a)
	;;
x86_64)
	TARGETS=(x86_64-linux-android)
	ABIS=(x86_64)
	;;
x86)
	TARGETS=(i686-linux-android)
	ABIS=(x86)
	;;
esac

echo "=== android-build: profile=$PROFILE flavor=$FLAVOR target=${usage_target:-emulator} ==="

if [[ "${usage_clean:-false}" == "true" ]]; then
	echo "  Cleaning Android build..."
	mise run android-clean
fi

export PKG_CONFIG_ALLOW_CROSS=1

for i in "${!TARGETS[@]}"; do
	TARGET="${TARGETS[$i]}"
	ABI="${ABIS[$i]}"
	echo "  Building $TARGET..."
	(
		cd "$CARGO_WS"
		cargo build -p livtet-ffi --target "$TARGET" ${CARGO_PROFILE_FLAG:+"$CARGO_PROFILE_FLAG"}
	)
	mkdir -p "$JNI_LIBS_DIR/$ABI"
	cp -v "$CARGO_WS/target/$TARGET/$CARGO_PROFILE_DIR/liblivtet_ffi.so" "$JNI_LIBS_DIR/$ABI/liblivtet_ffi.so"
done

FIRST_TARGET="${TARGETS[0]}"

echo "  Generating Kotlin bindings for $FIRST_TARGET..."
(
	cd "$CARGO_WS"
	cargo run --bin uniffi-bindgen -p livtet-ffi --features cli -- generate \
		--language kotlin \
		--out-dir "../android/build/generated/source/uniffi/kotlin" \
		"target/$FIRST_TARGET/$CARGO_PROFILE_DIR/liblivtet_ffi.so"
)

echo "  Assembling APK (${FLAVOR_CAP}${PROFILE_CAP})..."
cd android
gradle ":app:assemble${FLAVOR_CAP}${PROFILE_CAP}"