#!/usr/bin/env bash
#MISE description="Convert .mise/secrets.json to shell-sourceable .mise/secrets.env (mobile-only LIVTET_* keys)"
#MISE sources=[".mise/secrets.json"]
#MISE outputs=[".mise/secrets.env"]
set -euo pipefail

# Mobile-only export: emits the three keys actually consumed by Android/iOS
# builds (google API keys + Sentry DSN). Drops web/desktop/Tauri/TAP/VITE keys
# that the source monorepo's secrets-export-env also emits; the mobile repo
# has no consumers for those.

DECRYPTED_FILE=".mise/secrets.json"
ENV_FILE=".mise/secrets.env"

if [ ! -f "$DECRYPTED_FILE" ]; then
	echo "Error: $DECRYPTED_FILE missing." >&2
	echo "Run 'mise run secrets-decrypt' first." >&2
	exit 1
fi

mkdir -p "$(dirname "$ENV_FILE")"
{
	for platform in ios android; do
		val=$(jq -r --arg p "$platform" '.api_keys.google.api[$p] // ""' "$DECRYPTED_FILE")
		printf 'LIVTET_GOOGLE_API_KEY_%s=%s\n' "$(echo "$platform" | tr '[:lower:]' '[:upper:]')" "$(jq -nr --arg v "$val" '$v | @sh')"
	done

	val=$(jq -r '.telemetry.sentry.mobile.dsn // ""' "$DECRYPTED_FILE")
	printf 'LIVTET_SENTRY_DSN_MOBILE=%s\n' "$(jq -nr --arg v "$val" '$v | @sh')"
} >"$ENV_FILE"

echo "Wrote $ENV_FILE (gitignored — do not commit)"