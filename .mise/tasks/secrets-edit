#!/usr/bin/env bash
#MISE description="Open .mise/secrets.json.sops in the editor and re-encrypt on save"
set -euo pipefail

ENCRYPTED_FILE=".mise/secrets.json.sops"

if [ -z "${SOPS_AGE_KEY:-}" ]; then
	echo "Error: SOPS_AGE_KEY is not set." >&2
	echo "Run 'mise run secrets-init' first to generate a key pair, then export SOPS_AGE_KEY in your shell." >&2
	exit 1
fi

if [ -z "${EDITOR:-}" ]; then
	echo "Error: EDITOR is not set. Export EDITOR to your preferred editor before running this task." >&2
	exit 1
fi

# sops exits 200 when the editor ran but the file was unchanged — that's a
# successful no-op for our purposes, not a failure. Anything else propagates.
#
# Use a subshell so we can capture sops' exit code without `$?` being
# shadowed by the `if` test.
rc=0
mise exec aqua:getsops/sops -- sops "$ENCRYPTED_FILE" || rc=$?
if [ "$rc" -ne 0 ] && [ "$rc" -ne 200 ]; then
	exit "$rc"
fi