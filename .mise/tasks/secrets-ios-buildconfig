#!/usr/bin/env bash
#MISE description="Generate ios/Livtet/Resources/BuildConfig.generated.swift from .mise/secrets.env"
#MISE sources=[".mise/secrets.env"]
#MISE outputs=["ios/Livtet/Resources/BuildConfig.generated.swift"]
set -euo pipefail

ENV_FILE=".mise/secrets.env"
OUT_FILE="ios/Livtet/Resources/BuildConfig.generated.swift"

if [ ! -f "$ENV_FILE" ]; then
	echo "Error: $ENV_FILE missing." >&2
	echo "Run 'mise run secrets-export-env' first." >&2
	exit 1
fi

# shellcheck source=/dev/null
. "$ENV_FILE"

mkdir -p "$(dirname "$OUT_FILE")"

# swift_value wraps a shell string value as a Swift string literal. The
# caller passes the unquoted value (`. .mise/secrets.env` strips the
# `@sh` single quotes during variable assignment). We replace any
# embedded `"` with `\"` and wrap in `"..."`. `tr '\n' ' '` collapses
# any embedded newlines (none today, but defensive).
swift_value() {
	local v
	v=$(printf '%s' "$1" | tr '\n' ' ')
	if [ -z "$v" ]; then
		printf '""'
	else
		# Escape any `"` in the value so the Swift literal stays valid.
		printf '"%s"' "$(printf '%s' "$v" | sed 's/"/\\"/g')"
	fi
}

{
	# shellcheck disable=SC2016
	printf '// AUTO-GENERATED — do not edit. Regenerated by `mise run secrets-ios-buildconfig`.\n'
	printf 'import Foundation\n\n'
	printf 'public enum BuildConfig {\n'
	printf '    public static let googleAPIKey: String = %s\n' "$(swift_value "${LIVTET_GOOGLE_API_KEY_IOS:-}")"
	printf '    public static let sentryDSN: String = %s\n' "$(swift_value "${LIVTET_SENTRY_DSN_MOBILE:-}")"
	printf '}\n'
} >"$OUT_FILE"

echo "Generated $OUT_FILE"