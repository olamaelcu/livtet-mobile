#!/usr/bin/env bash
#MISE description="Remove all generated files from android/ (Gradle caches, build outputs, generated sources, JNI libs, local.properties)"
#MISE outputs=[]
#USAGE flag "--keep-local-properties" help="Don't delete local.properties (preserves SDK/NDK path)"

set -e
# shellcheck disable=SC1091
source "$(dirname "${BASH_SOURCE[0]}")/_os-check" && require_os linux

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MOBILE_REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
ANDROID_DIR="$MOBILE_REPO_ROOT/android"

echo "=== android-clean ==="

rm -rf "$ANDROID_DIR/.gradle"
rm -rf "$ANDROID_DIR/.kotlin"
rm -rf "$ANDROID_DIR/build"
rm -rf "$ANDROID_DIR/app/build"
rm -rf "$ANDROID_DIR/core/designsystem/build"
rm -rf "$ANDROID_DIR/app/src/main/jniLibs"

if [ "${usage_keep_local_properties:-false}" != "true" ]; then
	rm -f "$ANDROID_DIR/local.properties"
fi

echo "=== android-clean: done ==="