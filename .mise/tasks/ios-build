#!/usr/bin/env bash
#MISE description="Build iOS app: Rust FFI (core/) → XCFramework → Xcode build. Flags: --sim|--device|--ipad|--clean"
#MISE env={_.file=".mise/secrets.env"}
#MISE depends=["secrets-export-env", "secrets-ios-buildconfig"]
#MISE sources=["core/livtet-ffi/**/*.rs", "core/livtet-core/**/*.rs", "core/livtet-types/**/*.rs", "core/livtet-search/**/*.rs", "core/livtet-temporal-quotes/**/*.rs", "ios/Livtet/**/*.swift", "ios/LivtetKit/**", "ios/project.yml"]
#MISE outputs=["ios/LivtetKit.xcframework/**", "ios/.derivedData/**/Livtet.app"]
#USAGE flag "--profile <profile>" help="Build profile" default="debug" {
#USAGE   choices "debug" "release"
#USAGE }
#USAGE flag "--sim" help="Build only for arm64 simulator (fast, skip x86_64). Use for Apple Silicon Macs."
#USAGE flag "--sim-x86" help="Build only for x86_64 simulator (fast, skip arm64). Use for Intel Macs."
#USAGE flag "--device" help="Build for physical device (aarch64-apple-ios). For simulators without --sim/--sim-x86, builds fat lib for both arm64 and x86_64."
#USAGE flag "--ipad" help="Build for iPad simulator (default: iPhone simulator)"
#USAGE flag "--clean" help="Delete the XCFramework before building (forces native rebuild)"
#USAGE flag "--only-swift" help="Skip native build and UniFFI binding generation; only compile Swift changes"

set -euo pipefail

# shellcheck source=/dev/null
source "$(dirname "${BASH_SOURCE[0]}")/_os-check" && require_os macos

# shellcheck source=/dev/null
source "$(dirname "${BASH_SOURCE[0]}")/_build_profile.sh"

PROJECT_DIR="ios"
DERIVED_DATA="$PROJECT_DIR/.derivedData"
XCFRAMEWORK_DIR="ios/LivtetKit.xcframework"
PHONE_SIM_NAME="Livtet iPhone"
TABLET_SIM_NAME="Livtet iPad"

# The Cargo workspace lives at core/ (git submodule). All cargo build
# artifacts go into core/target/, so ROOT_CARGO is what the task uses
# to address those outputs.
MOBILE_ROOT="$(pwd)"
CARGO_WS="$MOBILE_ROOT/core"
ROOT_CARGO="$CARGO_WS"

#######################################
# Native: Build Rust FFI and create XCFramework
#######################################
build_native() {
	local TARGETS=()
	local TARGET_LABEL=""

	if [ "${usage_sim:-false}" = "true" ]; then
		# Fast path: only arm64 simulator (no x86_64, no fat library)
		TARGETS=(aarch64-apple-ios-sim)
		TARGET_LABEL="sim-arm64"
	elif [ "${usage_sim_x86:-false}" = "true" ]; then
		# Fast path: only x86_64 simulator (no arm64, no fat library) - native on Intel
		TARGETS=(x86_64-apple-ios)
		TARGET_LABEL="sim-x86"
	elif [ "${usage_device:-false}" = "true" ]; then
		TARGETS=(aarch64-apple-ios)
		TARGET_LABEL="device"
	else
		# Default: both simulator architectures (fat library)
		TARGETS=(aarch64-apple-ios-sim x86_64-apple-ios)
		TARGET_LABEL="sim-fat"
	fi

	echo "=== ios-build: Building livtet-ffi for targets: $TARGET_LABEL (profile: $PROFILE) ==="
	for TARGET in "${TARGETS[@]}"; do
		echo "--- Building for $TARGET ---"
		(
			cd "$CARGO_WS"
			if [[ -n "$CARGO_PROFILE_FLAG" ]]; then
				cargo build -p livtet-ffi --target "$TARGET" ${CARGO_PROFILE_FLAG:+"$CARGO_PROFILE_FLAG"}
			else
				cargo build -p livtet-ffi --target "$TARGET"
			fi
		)
	done

	local BUILT_DEVICE=false
	local BUILT_SIM_ARM=false
	local BUILT_SIM_X86=false
	for T in "${TARGETS[@]}"; do
		case "$T" in
		aarch64-apple-ios) BUILT_DEVICE=true ;;
		aarch64-apple-ios-sim) BUILT_SIM_ARM=true ;;
		x86_64-apple-ios) BUILT_SIM_X86=true ;;
		esac
	done

	# Create the fat simulator library when both arches were built.
	# mlua is gone from the core workspace, so the archives are linked
	# directly with lipo — no vendored Lua objects to merge in.
	local SIM_FAT_DIR="$ROOT_CARGO/target/ios-sim-fat"
	if [ "$BUILT_SIM_ARM" = true ] && [ "$BUILT_SIM_X86" = true ]; then
		mkdir -p "$SIM_FAT_DIR"
		echo "--- Creating simulator fat library ---"
		lipo -create \
			"$ROOT_CARGO/target/aarch64-apple-ios-sim/$CARGO_PROFILE_DIR/liblivtet_ffi.a" \
			"$ROOT_CARGO/target/x86_64-apple-ios/$CARGO_PROFILE_DIR/liblivtet_ffi.a" \
			-output "$SIM_FAT_DIR/liblivtet_ffi.a"
	fi

	echo "=== Creating XCFramework ==="
	mkdir -p "$(dirname "$MOBILE_ROOT/$XCFRAMEWORK_DIR")"
	rm -rf "$MOBILE_ROOT/$XCFRAMEWORK_DIR"

	local XCFW_LIBS=()

	if [ "$BUILT_DEVICE" = true ]; then
		XCFW_LIBS+=(-library "$ROOT_CARGO/target/aarch64-apple-ios/$CARGO_PROFILE_DIR/liblivtet_ffi.a")
	elif [ "$BUILT_SIM_ARM" = true ] && [ "$BUILT_SIM_X86" = true ]; then
		XCFW_LIBS+=(-library "$SIM_FAT_DIR/liblivtet_ffi.a")
	elif [ "$BUILT_SIM_ARM" = true ]; then
		XCFW_LIBS+=(-library "$ROOT_CARGO/target/aarch64-apple-ios-sim/$CARGO_PROFILE_DIR/liblivtet_ffi.a")
	elif [ "$BUILT_SIM_X86" = true ]; then
		XCFW_LIBS+=(-library "$ROOT_CARGO/target/x86_64-apple-ios/$CARGO_PROFILE_DIR/liblivtet_ffi.a")
	fi

	xcodebuild -create-xcframework "${XCFW_LIBS[@]}" -output "$MOBILE_ROOT/$XCFRAMEWORK_DIR" | xcbeautify

	echo "XCFramework created: $XCFRAMEWORK_DIR"
}

#######################################
# Check prerequisites
#######################################
# Note: We no longer use CocoaPods (disabled in project.yml)
# Check for the Xcode project instead of workspace
if [[ ! -d "$PROJECT_DIR/Livtet.xcodeproj" ]]; then
	echo "ERROR: Xcode project not found at $PROJECT_DIR/Livtet.xcodeproj" >&2
	echo "       Run 'mise run ios-dev-init' first to set up the iOS environment." >&2
	exit 1
fi

#######################################
# Build native libraries if needed
#######################################
if [ "${usage_clean:-false}" = "true" ] && [ -d "$XCFRAMEWORK_DIR" ]; then
	echo "=== --clean: Removing $XCFRAMEWORK_DIR ==="
	rm -rf "$XCFRAMEWORK_DIR"
fi

if [[ ! -d "$XCFRAMEWORK_DIR" ]]; then
	echo "=== XCFramework not found, building native libraries ==="
	build_native
else
	echo "=== XCFramework exists, skipping native build ==="
	echo "    (delete $XCFRAMEWORK_DIR to force rebuild)"
fi

#######################################
# Generate Swift UniFFI bindings
#
# Mirrors the Android pipeline in `.mise/tasks/android-build`: the
# generated Swift package source files in
# `ios/LivtetKit/Sources/` are derived artefacts of the
# compiled Rust library, so we (re)generate them every run instead
# of relying on a stale checked-in copy. The regeneration is
# cheap (text only) and prevents the iOS build from breaking
# when a new record type is added to `livtet-ffi`.
#
# `uniffi-bindgen generate` dumps all output into a single
# directory using a fixed naming convention (`livtet_ffi.swift`,
# the `*FFI.h` headers, etc.) that doesn't know about the
# existing per-target subdirectories in the Swift package.
# Stage the output to a temp dir, verify each expected file is
# present, then `mv` each file into the per-target subdirectory
# that owns it (see `Package.swift`).
#######################################
generate_swift_bindings() {
	local LIB_PATH=""
	if [ "${usage_device:-false}" = "true" ]; then
		LIB_PATH="$ROOT_CARGO/target/aarch64-apple-ios/$CARGO_PROFILE_DIR/liblivtet_ffi.a"
	elif [ "${usage_sim:-false}" = "true" ]; then
		# Single arch arm64 simulator build
		LIB_PATH="$ROOT_CARGO/target/aarch64-apple-ios-sim/$CARGO_PROFILE_DIR/liblivtet_ffi.a"
	elif [ "${usage_sim_x86:-false}" = "true" ]; then
		# Single arch x86_64 simulator build
		LIB_PATH="$ROOT_CARGO/target/x86_64-apple-ios/$CARGO_PROFILE_DIR/liblivtet_ffi.a"
	else
		# Fat simulator library (both arm64 + x86_64)
		LIB_PATH="$ROOT_CARGO/target/ios-sim-fat/liblivtet_ffi.a"
	fi

	if [ ! -f "$LIB_PATH" ]; then
		echo "ERROR: liblivtet_ffi.a not found at $LIB_PATH (expected from --device=${usage_device:-false} --sim=${usage_sim:-false} --sim-x86=${usage_sim_x86:-false} build)" >&2
		exit 1
	fi

	echo "=== ios-build: Generating Swift UniFFI bindings from $LIB_PATH ==="

	local STAGING
	STAGING="$(mktemp -d)"

	uniffi-bindgen generate \
		"$LIB_PATH" \
		--language swift \
		--out-dir "$STAGING"

	local SWIFT_PKG="$MOBILE_ROOT/ios/LivtetKit/Sources"

	# Ensure target directories exist for generated bindings. The three
	# Swift sources compile into the single `LivtetKit` module; each
	# component keeps its own C bridge module.
	mkdir -p "$SWIFT_PKG/LivtetKit"
	mkdir -p "$SWIFT_PKG/livtet_ffiFFI"
	mkdir -p "$SWIFT_PKG/LivtetTypesFFI"
	mkdir -p "$SWIFT_PKG/LivtetSearchFFI"
	# Move a required file from staging to its per-target subdirectory.
	# Aborts the build if bindgen did not produce the file (the build
	# would otherwise link against stale generated content).
	#
	# After moving, strip trailing whitespace — uniffi-bindgen emits
	# lines with trailing spaces and tabs in its Swift and C header
	# output, which trips hk's trailing-whitespace step and produces
	# noisy diffs against the checked-in copies. Normalising at this
	# boundary keeps the canonical Swift package sources clean.
	move_required() {
		local src="$1" dst="$2"
		if [ ! -f "$src" ]; then
			echo "ERROR: bindgen did not produce $src (expected destination: $dst)" >&2
			exit 1
		fi
		mv "$src" "$dst"
		sed -i '' 's/[[:space:]]\+$//' "$dst"
	}

	# Per-target destinations, mapped from bindgen's flat output names.
	# The destination subdirectories are owned by Swift targets defined
	# in `ios/LivtetKit/Package.swift`.
	move_required "$STAGING/livtet_ffi.swift" \
		"$SWIFT_PKG/LivtetKit/livtet_ffi.swift"
	move_required "$STAGING/LivtetTypes.swift" \
		"$SWIFT_PKG/LivtetKit/LivtetTypes.swift"
	move_required "$STAGING/LivtetSearch.swift" \
		"$SWIFT_PKG/LivtetKit/LivtetSearch.swift"

	move_required "$STAGING/livtet_ffiFFI.h" \
		"$SWIFT_PKG/livtet_ffiFFI/livtet_ffiFFI.h"
	move_required "$STAGING/livtet_ffiFFI.modulemap" \
		"$SWIFT_PKG/livtet_ffiFFI/module.modulemap"
	move_required "$STAGING/LivtetTypesFFI.h" \
		"$SWIFT_PKG/LivtetTypesFFI/LivtetTypesFFI.h"
	move_required "$STAGING/LivtetTypesFFI.modulemap" \
		"$SWIFT_PKG/LivtetTypesFFI/module.modulemap"
	move_required "$STAGING/LivtetSearchFFI.h" \
		"$SWIFT_PKG/LivtetSearchFFI/LivtetSearchFFI.h"
	move_required "$STAGING/LivtetSearchFFI.modulemap" \
		"$SWIFT_PKG/LivtetSearchFFI/module.modulemap"

	# Note: `uniffi-bindgen` 0.31 no longer emits per-language
	# `anchor.c` files; the `module.modulemap` it produces is
	# self-contained. Any pre-existing `anchor.c` under each
	# per-target subdirectory is a leftover from an older
	# bindgen and is no longer needed by the build.
}

if [ "${usage_only_swift:-false}" != "true" ]; then
    generate_swift_bindings
fi

#######################################
# Set up simulator destination
#######################################
if [ "${usage_device:-false}" = "true" ]; then
	PLATFORM="device"
	DESTINATION="generic/platform=iOS"
else
	PLATFORM="simulator"
	if [ "${usage_ipad:-false}" = "true" ]; then
		SIM_NAME="$TABLET_SIM_NAME"
	else
		SIM_NAME="$PHONE_SIM_NAME"
	fi

	SIM_UDID=$(xcrun simctl list devices available 2>/dev/null |
		grep -E "^\s+$SIM_NAME \([a-fA-F0-9-]+\)" |
		awk -F'[()]' '{print $2}')

	if [[ -z "${SIM_UDID:-}" ]]; then
		echo "ERROR: No '$SIM_NAME' simulator found. Run 'mise run ios-dev-init'." >&2
		exit 1
	fi

	DESTINATION="platform=iOS Simulator,id=${SIM_UDID}"
fi

#######################################
# Build the iOS app
#######################################
echo "=== Building iOS app ($PLATFORM, profile=$PROFILE) ==="

if [ "$PLATFORM" = "device" ]; then
	env -u CC -u CXX xcodebuild \
		-project "$PROJECT_DIR/Livtet.xcodeproj" \
		-scheme Livtet \
		-configuration "$PROFILE" \
		-sdk iphoneos \
		-destination "$DESTINATION" \
		-derivedDataPath "$DERIVED_DATA" \
		build | xcbeautify
else
	env -u CC -u CXX xcodebuild \
		-project "$PROJECT_DIR/Livtet.xcodeproj" \
		-scheme Livtet \
		-configuration "$PROFILE" \
		-destination "$DESTINATION" \
		-sdk iphonesimulator \
		-derivedDataPath "$DERIVED_DATA" \
		build | xcbeautify
fi

echo ""
echo "=== ios-build complete ==="