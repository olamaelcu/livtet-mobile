#!/usr/bin/env bash
#MISE description="Decrypt .mise/secrets.json.sops to .mise/secrets.json using SOPS_AGE_KEY from the environment"
#MISE sources=[".mise/secrets.json.sops", ".mise/.sops-age-key-fingerprint"]
#MISE outputs=[".mise/secrets.json"]
set -euo pipefail

ENCRYPTED_FILE=".mise/secrets.json.sops"
DECRYPTED_FILE=".mise/secrets.json"
SENTINEL_FILE=".mise/.sops-age-key-fingerprint"

if [ -z "${SOPS_AGE_KEY:-}" ]; then
	echo "Error: SOPS_AGE_KEY is not set." >&2
	echo "This is loaded from .envrc via direnv — run \`direnv allow\` in the repo root, or ask a project maintainer for the key." >&2
	echo "\`mise run secrets-init\` is a maintainer-only bootstrap that overwrites .sops.yaml and re-encrypts the bundle; do not run it." >&2
	exit 1
fi

if [ ! -f "$ENCRYPTED_FILE" ]; then
	echo "Error: $ENCRYPTED_FILE does not exist." >&2
	echo "The encrypted bundle should be in the repo from clone; verify with \`git status\`." >&2
	echo "\`mise run secrets-init\` is maintainer-only." >&2
	exit 1
fi

# Rewrite the SOPS_AGE_KEY fingerprint sentinel on every run. Mise compares
# this mtime against .mise/secrets.json — bumping the fingerprint forces
# re-decryption whenever the key changes (e.g. after a rotation).
mkdir -p "$(dirname "$SENTINEL_FILE")"
printf '%s' "$SOPS_AGE_KEY" | shasum -a 256 | awk '{print substr($1,1,16)}' >"$SENTINEL_FILE"

sops --decrypt --output "$DECRYPTED_FILE" "$ENCRYPTED_FILE"

echo "Decrypted to $DECRYPTED_FILE (gitignored — do not commit)"