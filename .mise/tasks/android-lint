#!/usr/bin/env bash
#MISE description="Check Kotlin formatting (ktfmt), ktlint and detekt across the Android build"
#MISE sources=["android/**/*.kt", "android/**/*.kts", "android/build-logic/**/*.kt"]
#MISE outputs=[]
#USAGE flag "--fix" help="Rewrite files with ktfmtFormat (the formatter of record), then run the checks"

set -e
# shellcheck disable=SC1091
source "$(dirname "${BASH_SOURCE[0]}")/_os-check" && require_os linux

echo "=== android-lint:${usage_fix:+ fix} ==="

cd android

# Task names here are Gradle's, not a wrapper's: `ktfmtCheck` / `ktfmtFormat` come
# from the ktfmt Gradle plugin, `ktlintCheck` / `ktlintFormat` from the ktlint
# plugin, and both are aggregated at the root, so every module (`:app` and each
# `:core:*`) is covered without a list to keep in sync.
#
# There is no flavor dimension to these: formatting and static analysis see the
# same sources whichever product flavor is built. The detekt variant tasks do
# exist per flavor, but `detekt` at the root runs each module's analysis once,
# which is what a lint pass needs.
#
# Only ktfmt may rewrite sources. ktlint's formatter disagrees with ktfmt's
# KotlinLang style (the convention plugins say so where they install it), so a
# `ktlintFormat` after `ktfmtFormat` leaves files that `ktfmtCheck` rejects.
# Here ktlint and detekt are analysis only.

if [ "${usage_fix:-false}" = "true" ]; then
	echo "  Auto-fix: ktfmtFormat, then ktfmtCheck + ktlintCheck + detekt"
	gradle ktfmtFormat
	gradle ktfmtCheck ktlintCheck detekt
else
	echo "  Check: ktfmtCheck + ktlintCheck + detekt"
	gradle ktfmtCheck ktlintCheck detekt
fi

echo "=== android-lint: done ==="
