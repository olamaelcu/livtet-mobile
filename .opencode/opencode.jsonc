{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "mobile-mcp": {
      "type": "local",
      "command": ["mise", "x", "--", "npx", "-y", "@mobilenext/mobile-mcp@latest"],
      "enabled": true
    },
    "taskwarrior": {
      "type": "local",
      "command": ["mise", "x", "--", "taskwarrior-mcp"],
      "enabled": true
    }

}
