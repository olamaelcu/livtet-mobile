<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Base theme for native Android views and pre-Compose surfaces (system bars, app icon, etc.).
        Compose screens consume MaterialTheme.colorScheme.* populated by
        livtetLightColorScheme() / livtetDarkColorScheme() (generated from tokens.json), so this XML
        theme is the fallback for system bars and any non-Compose surfaces. The brand color
        override keeps the system bar tinted during cold start before Compose renders; Compose's
        enableEdgeToEdge() then takes over for in-app theming.
    -->
    <style name="Theme.Livtet" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/brand</item>
        <item name="android:navigationBarColor">@color/brand</item>
        <item name="android:windowBackground">@color/brand</item>
    </style>
</resources>