<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Sentry event upload only; every feature that used the network is gone. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Peer discovery: NsdManager browses _livtet-sync._tcp, which needs the
         multicast lock on some OEM builds. Both are normal permissions. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- The background poll announces books a paired device offered. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application android:name=".LivtetApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Livtet">
        <!-- Sentry auto-init stays off: LivtetApp.onCreate initialises it manually
             so the empty DSN in fdroid/generic does not crash at attach time. -->
        <meta-data android:name="io.sentry.auto-init" android:value="false" />
        <!-- `singleTop` because the sign-in redirect lands here: a second
             instance would have to re-open the store to finish the exchange. -->
        <activity android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Livtet">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The platform's OAuth redirect. Must equal the AS client's
                 AS_MOBILE_REDIRECT_URI (default livtet://oauth/callback). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="livtet" android:host="oauth" android:pathPrefix="/callback" />
            </intent-filter>
        </activity>
        <!-- Reads one edition's file. Not exported: it is only ever started
             from this app, with an edition id it resolves itself. The config
             changes keep the toolkit's Publication alive across rotation. -->
        <activity android:name=".ReaderActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.Livtet" />
        <!-- Pairing and the devices this one can exchange books with. Not
             exported: reached only from the launcher. -->
        <activity android:name=".SyncActivity"
            android:exported="false"
            android:theme="@style/Theme.Livtet" />
        <!-- The reader's platform feed, for a signed-in app. Not exported: it
             has no deep link of its own. -->
        <activity android:name=".FeedActivity"
            android:exported="false"
            android:theme="@style/Theme.Livtet" />
        <!-- Named reading lists. Not exported: reached from the library and the
             home screen. -->
        <activity android:name=".ShelvesActivity"
            android:exported="false"
            android:theme="@style/Theme.Livtet" />
        <!-- Every book on this device, filterable. Reached from the home
             shelf's "See all"; not exported. -->
        <activity android:name=".LibraryActivity"
            android:exported="false"
            android:theme="@style/Theme.Livtet" />
        <!-- Books a peer offered, waiting on a decision. -->
        <activity android:name=".OffersActivity"
            android:exported="false"
            android:theme="@style/Theme.Livtet" />
    </application>
</manifest>
